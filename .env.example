APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base URL of the dashboard SPA. Every credential email links to
# FRONTEND_URL/login; unset it and the framework default (http://localhost:3000)
# ships a dead link to real users.
FRONTEND_URL=http://localhost:3000

# Comma-separated CORS origins (config/cors.php). Falls back to FRONTEND_URL,
# then '*'. Pin it in staging/production; the wildcard is a local-dev default.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.sa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Feature flags (config/features.php). Routes behind a disabled flag are not
# registered at all — the paths 404, they do not 403.
# ASAB dashboard supplier portal (/api/v1/asab/supplier/*). Hidden in v1 per the
# client meeting until unified with the legacy mobile portal; keep it off.
FEATURE_ASAB_SUPPLIER_PORTAL=false
# Mobile «activate Account»: force the password change before the account works.
# Request-time behaviour (not routing). Off since 2026-07-26 because the app's
# activation screen sends no proof of identity, which locked accounts out for
# good; the first sign-in completes activation instead. Flip on only after the
# app posts identifier+default_password (or the first-login token).
MOBILE_FORCE_FIRST_LOGIN_RESET=false

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Firebase Cloud Messaging (device push) ──────────────────────────────────
# Separate transport from the Pusher broadcast: Pusher updates a client that is
# already open, FCM wakes a backgrounded or killed app.
#
# `null` performs no network calls and logs what would have been sent, so the
# app runs correctly with no Firebase project. Switch to `http_v1` once the
# service-account key is in place. There is no legacy server-key mode —
# Google shut that API down in 2024.
FCM_DRIVER=null
# Absolute path to the Firebase service-account JSON key. KEEP IT OUT OF GIT:
# it grants send rights on the entire Firebase project.
# FIREBASE_CREDENTIALS=/var/www/assab/storage/app/firebase/service-account.json
# Optional; defaults to project_id inside the key file.
# FIREBASE_PROJECT_ID=
# Queue that push jobs run on. Point your worker at it: `queue:work --queue=notifications`
FCM_QUEUE=notifications
FCM_TIMEOUT=10
# Must match the notification channel the Android app creates, or Android 8+
# silently drops every notification.
FCM_ANDROID_CHANNEL_ID=assab_default
# How long FCM holds a message for an offline device (seconds).
FCM_TTL_SECONDS=86400
# Also push to the same person's account in the other world (dashboard ↔ legacy
# mobile) via the ASAB identity map.
FCM_MIRROR_LINKED_IDENTITIES=true
# Delete device tokens unused for this many days (weekly scheduled prune).
FCM_STALE_TOKEN_DAYS=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs/laravel.log instead of sending it. Any
# environment that provisions real logins needs a real mailer here: credential
# mail is refused outright under `log` (CredentialMailer), so passwords are
# never emailed and never written to the log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be a domain the provider will send for, or every credential email bounces.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
