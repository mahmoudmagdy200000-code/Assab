{
  "openapi": "3.0.0",
  "info": {
    "title": "Recurring Orders Management API",
    "description": "Section 3.1.2.6 - Branch Manager recurring orders: In Progress, Next Scheduling, Paused lists; Add/View/Update/Pause/Resume/Delete.",
    "version": "1.0.0",
    "contact": {
      "name": "Assab API Support"
    }
  },
  "servers": [
    {
      "url": "/api/v1/recurring-orders",
      "description": "Recurring Orders API Base URL"
    }
  ],
  "tags": [
    {
      "name": "In Progress",
      "description": "3.1.2.6.1 Recurring Orders – In Progress List (Generated / In Progress)"
    },
    {
      "name": "Next Scheduling",
      "description": "3.1.2.6.2 Recurring Orders – Next Scheduling List (Pending)"
    },
    {
      "name": "Paused",
      "description": "3.1.2.6.3 Recurring Orders – Paused Schedules List"
    },
    {
      "name": "Add Recurring Order",
      "description": "3.1.2.6.1.1 Add Recurring Orders – form data and create"
    },
    {
      "name": "View Details",
      "description": "3.1.2.6.1.2 / 3.1.2.6.2.1 / 3.1.2.6.3.1 View Recurring Order Details"
    },
    {
      "name": "Actions",
      "description": "Pause, Resume, Update, Delete recurring order"
    }
  ],
  "paths": {
    "/in-progress": {
      "get": {
        "tags": ["In Progress"],
        "summary": "In Progress List",
        "description": "List recurring orders with status Generated or In Progress. Displayed: Order Name, Type (Via Direct Supplier / Via Purchasing Officer), Status (Generated / In Progress).",
        "operationId": "getRecurringOrdersInProgress",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search by order name",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page",
            "required": false,
            "schema": { "type": "integer", "default": 15, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring orders (in progress) retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderListPaginated" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/next-scheduling": {
      "get": {
        "tags": ["Next Scheduling"],
        "summary": "Next Scheduling List",
        "description": "List recurring orders with status Pending. Displayed: Order Name, Type, Status (Pending with next order message).",
        "operationId": "getRecurringOrdersNextScheduling",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 15 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring orders (next scheduling) retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderListPaginated" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/paused": {
      "get": {
        "tags": ["Paused"],
        "summary": "Paused List",
        "description": "List recurring orders with status Paused.",
        "operationId": "getRecurringOrdersPaused",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 15 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring orders (paused) retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderListPaginated" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/suppliers": {
      "get": {
        "tags": ["Add Recurring Order"],
        "summary": "List suppliers",
        "description": "For Add Recurring Order – Direct Supplier: view and search supplier list. Each supplier: name, image, status (online/offline).",
        "operationId": "getSuppliersForRecurringOrder",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "schema": { "type": "string", "enum": ["online", "offline"] }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Suppliers retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderPaginated" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/purchasing-officers": {
      "get": {
        "tags": ["Add Recurring Order"],
        "summary": "List purchasing officers",
        "description": "For Add Recurring Order – Via Purchasing Officer: view and search list with name, image, status (online/offline).",
        "operationId": "getPurchasingOfficersForRecurringOrder",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchasing officers retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderPaginated" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/": {
      "post": {
        "tags": ["Add Recurring Order"],
        "summary": "Add Recurring Order",
        "description": "3.1.2.6.1.1 Create and activate a new recurring order. System will send requests per Repeat Frequency and Scheduled Time. Notification options and Smart Settings apply.",
        "operationId": "storeRecurringOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StoreRecurringOrderRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recurring order created and activated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderDetailResponse" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/{id}": {
      "get": {
        "tags": ["View Details"],
        "summary": "View Recurring Order Details",
        "description": "3.1.2.6.1.2 / 3.1.2.6.2.1 / 3.1.2.6.3.1 – Status, Inspection Summary, Item Count and Availability, Details (items + scheduling settings), History, Available Actions.",
        "operationId": "showRecurringOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring order details retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderDetailResponse" }
              }
            }
          },
          "404": {
            "description": "Recurring order not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "put": {
        "tags": ["Actions"],
        "summary": "Update Recurring Order",
        "description": "Update order details, settings, scheduling time, notification options, smart settings, schedule duration.",
        "operationId": "updateRecurringOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateRecurringOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recurring order updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderDetailResponse" }
              }
            }
          },
          "404": { "description": "Recurring order not found" },
          "422": { "description": "Validation error" }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "delete": {
        "tags": ["Actions"],
        "summary": "Delete Recurring Order",
        "description": "Permanently delete the recurring order.",
        "operationId": "destroyRecurringOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring order deleted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessMessageResponse" }
              }
            }
          },
          "404": { "description": "Recurring order not found" }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/{id}/pause": {
      "post": {
        "tags": ["Actions"],
        "summary": "Pause Recurring Order",
        "description": "Pause so the order is not sent to supplier/officer until reactivated.",
        "operationId": "pauseRecurringOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring order paused successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderDetailResponse" }
              }
            }
          },
          "404": { "description": "Recurring order not found" }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/{id}/resume": {
      "post": {
        "tags": ["Actions"],
        "summary": "Resume Recurring Order",
        "description": "Resume a paused recurring order; status becomes Pending.",
        "operationId": "resumeRecurringOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring order resumed successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringOrderDetailResponse" }
              }
            }
          },
          "404": { "description": "Recurring order not found" }
        },
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Branch Manager Sanctum token"
      }
    },
    "schemas": {
      "RecurringOrderListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "order_name": { "type": "string" },
          "type": { "type": "string", "enum": ["Via Direct Supplier", "Via Purchasing Officer"] },
          "type_value": { "type": "string", "enum": ["direct_supplier", "via_purchasing_officer"] },
          "status": { "type": "string", "enum": ["Generated", "In Progress", "Pending", "Paused"] },
          "status_value": { "type": "string", "enum": ["generated", "in_progress", "pending", "paused"] }
        }
      },
      "RecurringOrderListPaginated": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecurringOrderListItem" }
          },
          "links": {
            "type": "object",
            "properties": {
              "first": { "type": "string" },
              "last": { "type": "string" },
              "prev": { "type": "string", "nullable": true },
              "next": { "type": "string", "nullable": true }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": { "type": "integer" },
              "from": { "type": "integer", "nullable": true },
              "last_page": { "type": "integer" },
              "path": { "type": "string" },
              "per_page": { "type": "integer" },
              "to": { "type": "integer", "nullable": true },
              "total": { "type": "integer" }
            }
          }
        }
      },
      "RecurringOrderPaginated": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" },
                "image": { "type": "string", "nullable": true },
                "status": { "type": "string", "enum": ["online", "offline"] }
              }
            }
          },
          "links": { "type": "object" },
          "meta": { "type": "object" }
        }
      },
      "StoreRecurringOrderRequest": {
        "type": "object",
        "required": ["order_name", "order_source_type", "items", "repeat_frequency", "start_date", "end_type"],
        "properties": {
          "order_name": { "type": "string", "maxLength": 255 },
          "order_source_type": { "type": "string", "enum": ["direct_supplier", "via_purchasing_officer"] },
          "supplier_id": { "type": "string", "format": "uuid", "description": "Required when order_source_type is direct_supplier" },
          "purchasing_officer_id": { "type": "string", "format": "uuid", "description": "Required when order_source_type is via_purchasing_officer" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item_id", "quantity", "unit_price"],
              "properties": {
                "item_id": { "type": "string", "format": "uuid" },
                "quantity": { "type": "number", "minimum": 0.001 },
                "quality": { "type": "string", "enum": ["economy", "standard", "premium"] },
                "unit_price": { "type": "number", "minimum": 0 }
              }
            }
          },
          "repeat_frequency": { "type": "string", "enum": ["weekly", "monthly", "based_on_inventory"] },
          "repeat_config": {
            "type": "object",
            "properties": {
              "repeat_days": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "description": "0=Sun..6=Sat, required if weekly" },
              "repeat_type": { "type": "string", "enum": ["by_date", "by_pattern"], "description": "Required if monthly" },
              "dates": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 31 } },
              "occurrence": { "type": "integer", "minimum": 1, "maximum": 5 },
              "day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
              "level_ratio": { "type": "string", "enum": ["10", "20", "40", "custom"] },
              "custom_threshold": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          },
          "scheduling_time_am": { "type": "string", "format": "HH:mm" },
          "scheduling_time_pm": { "type": "string", "format": "HH:mm" },
          "notification_options": {
            "type": "array",
            "items": { "type": "string", "enum": ["alert_24_hours_before", "review_before_sending", "send_automatically_without_review"] },
            "description": "Cannot select both review_before_sending and send_automatically_without_review"
          },
          "smart_settings": {
            "type": "array",
            "items": { "type": "string", "enum": ["auto_adjust_quantities_based_on_consumption", "freeze_during_holidays_and_events", "notify_when_prices_change"] }
          },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "end_type": { "type": "string", "enum": ["repeat", "date"] }
        }
      },
      "UpdateRecurringOrderRequest": {
        "type": "object",
        "properties": {
          "order_name": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/RecurringOrderItemInput" } },
          "repeat_config": { "type": "object" },
          "scheduling_time_am": { "type": "string", "format": "HH:mm" },
          "scheduling_time_pm": { "type": "string", "format": "HH:mm" },
          "notification_options": { "type": "array", "items": { "type": "string" } },
          "smart_settings": { "type": "array", "items": { "type": "string" } },
          "end_date": { "type": "string", "format": "date" },
          "end_type": { "type": "string", "enum": ["repeat", "date"] }
        }
      },
      "RecurringOrderItemInput": {
        "type": "object",
        "properties": {
          "item_id": { "type": "string", "format": "uuid" },
          "quantity": { "type": "number" },
          "quality": { "type": "string", "enum": ["economy", "standard", "premium"] },
          "unit_price": { "type": "number" }
        }
      },
      "RecurringOrderDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "status_section": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "status_value": { "type": "string" },
                  "message": { "type": "string" }
                }
              },
              "inspection_summary": {
                "type": "object",
                "properties": {
                  "order_name": { "type": "string" },
                  "direct_supplier_or_purchasing_officer_name": { "type": "string" },
                  "repeat_frequency": { "type": "string" },
                  "next_order_scheduling": { "type": "string", "format": "date", "nullable": true },
                  "scheduling_time": { "type": "string" }
                }
              },
              "item_count_and_availability": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "item_name": { "type": "string" },
                    "item_logo": { "type": "string", "nullable": true },
                    "quantity_purchased": { "type": "number" },
                    "quantity_in_stock": { "type": "number" }
                  }
                }
              },
              "details": {
                "type": "object",
                "properties": {
                  "inspection_summary": { "type": "object" },
                  "items_summary": { "type": "array" },
                  "scheduling_settings": { "type": "object" }
                }
              },
              "history": {
                "type": "object",
                "properties": {
                  "total_completed_orders": { "type": "integer" },
                  "total_canceled_orders": { "type": "integer" },
                  "list": { "type": "array" }
                }
              },
              "available_actions": {
                "type": "array",
                "items": { "type": "string", "enum": ["pause_recurring_order", "resume_recurring_order", "update_recurring_order", "delete_recurring_order"] }
              }
            }
          }
        }
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object" }
        }
      }
    }
  }
}
