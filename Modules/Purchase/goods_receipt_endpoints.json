{
    "openapi": "3.0.0",
    "info": {
        "title": "Goods Receipt API",
        "description": "Complete API documentation for Goods Receipt System (3.1.2.4.4)",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1/purchase/receiving",
            "description": "Goods Receipt API Server"
        }
    ],
    "tags": [
        {
            "name": "Goods Receiving",
            "description": "Goods receipt management endpoints"
        }
    ],
    "paths": {
        "/in-progress": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get In-Progress Receipts",
                "description": "Get list of receipts that are in progress (draft or in_progress status)",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        },
                        "description": "Number of items per page"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "example": {
                                    "success": true,
                                    "message": "In-progress receipts retrieved successfully",
                                    "data": [
                                        {
                                            "items_count": 5,
                                            "order_type": "direct_supplier",
                                            "status": "in_progress",
                                            "date": "2025-01-15 10:30:00"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/orders": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Orders for Receiving",
                "description": "Get list of orders ready for receiving",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "direct_supplier",
                                "via_purchasing_officer",
                                "internal_transfer"
                            ]
                        },
                        "description": "Filter by order type"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/drafts": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Draft Receipts",
                "description": "Get list of draft receipts saved by Branch Manager",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by order type"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/drafts/{id}": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Draft Details",
                "description": "Get detailed information about a draft receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Draft receipt not found"
                    }
                }
            }
        },
        "/missing": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Missing Goods Receipts",
                "description": "Get list of receipts with missing goods (variances)",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "direct_supplier",
                                "via_purchasing_officer"
                            ]
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/missing/{id}": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Missing Goods Details",
                "description": "Get detailed information about missing goods receipt with tracking and supplier info",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Missing goods receipt not found"
                    }
                }
            }
        },
        "/completed": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Completed Receipts",
                "description": "Get list of completed receipts",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/completed/{id}": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Complete Goods Details",
                "description": "Get detailed information about completed goods receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Complete goods receipt not found"
                    }
                }
            }
        },
        "/orders/{orderId}/start": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Start Receiving Order",
                "description": "Start receiving process for an order",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Receiving started successfully"
                    },
                    "400": {
                        "description": "Order cannot be received in current status"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                }
            }
        },
        "/orders/{orderId}/receive-internal-transfer": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Receive Internal Transfer",
                "description": "Receive internal transfer order from another branch",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "driver_name": { "type": "string" },
                                    "driver_contact": { "type": "string" },
                                    "vehicle_number": { "type": "string" },
                                    "arrival_time": {
                                        "type": "string",
                                        "format": "date-time"
                                    },
                                    "delivery_address": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Internal transfer received successfully"
                    },
                    "400": {
                        "description": "This endpoint is only for internal transfer orders"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                }
            }
        },
        "/orders/{orderId}/tracking": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Order Tracking",
                "description": "Get order tracking stages (Preparing, Out for Delivery, Delivered, Order Confirmation, Variance Logged)",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                }
            }
        },
        "/without-order": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Receive Without Prior Order",
                "description": "Receive goods without a prior purchase order",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["supplier_id", "items"],
                                "properties": {
                                    "supplier_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "delivery_reference": { "type": "string" },
                                    "driver_name": { "type": "string" },
                                    "driver_contact": { "type": "string" },
                                    "vehicle_number": { "type": "string" },
                                    "arrival_time": {
                                        "type": "string",
                                        "format": "date-time"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "required": [
                                                "product_name",
                                                "quantity",
                                                "quality"
                                            ],
                                            "properties": {
                                                "product_name": {
                                                    "type": "string"
                                                },
                                                "item_id": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "unit": {
                                                    "type": "string",
                                                    "enum": ["kg", "pk"]
                                                },
                                                "quantity": {
                                                    "type": "number"
                                                },
                                                "price_per_unit": {
                                                    "type": "number"
                                                },
                                                "quality": {
                                                    "type": "string",
                                                    "enum": [
                                                        "excellent",
                                                        "normal",
                                                        "poor"
                                                    ]
                                                },
                                                "temperature": {
                                                    "type": "number"
                                                },
                                                "expiry_date": {
                                                    "type": "string",
                                                    "format": "date"
                                                },
                                                "payment_terms": {
                                                    "type": "string"
                                                },
                                                "note": { "type": "string" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Goods received successfully"
                    }
                }
            }
        },
        "/{id}": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Receipt Details",
                "description": "Get detailed information about a receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/summary": {
            "get": {
                "tags": ["Goods Receiving"],
                "summary": "Get Receipt Summary",
                "description": "Get comprehensive receipt summary including inspection, goods, documents, variances, and financial details",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/delivery-details": {
            "put": {
                "tags": ["Goods Receiving"],
                "summary": "Update Delivery Details",
                "description": "Update delivery details for a receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "driver_name": { "type": "string" },
                                    "driver_contact": { "type": "string" },
                                    "driver_image": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "vehicle_number": { "type": "string" },
                                    "arrival_time": {
                                        "type": "string",
                                        "format": "date-time"
                                    },
                                    "delivery_address": { "type": "string" },
                                    "delivery_notes": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Delivery details updated successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/items/{itemId}/inspect": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Inspect Item",
                "description": "Inspect and update item details (quantity received, quality, temperature, expiry, photo, notes)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "itemId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "required": ["quantity_received", "quality"],
                                "properties": {
                                    "quantity_received": {
                                        "type": "number",
                                        "minimum": 0
                                    },
                                    "quality": {
                                        "type": "string",
                                        "enum": ["excellent", "normal", "poor"]
                                    },
                                    "temperature": { "type": "number" },
                                    "expiry_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "photo": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "notes": {
                                        "type": "string",
                                        "maxLength": 1000
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Item inspected successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            }
        },
        "/{id}/unlisted-item": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Add Unlisted Item",
                "description": "Add unlisted item (gift from supplier) to receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "item_name",
                                    "unit",
                                    "quantity",
                                    "quality"
                                ],
                                "properties": {
                                    "item_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "item_name": { "type": "string" },
                                    "item_logo": { "type": "string" },
                                    "unit": {
                                        "type": "string",
                                        "enum": [
                                            "kg",
                                            "pk",
                                            "unit",
                                            "box",
                                            "liter",
                                            "piece"
                                        ]
                                    },
                                    "quantity": {
                                        "type": "number",
                                        "minimum": 0.001
                                    },
                                    "quality": {
                                        "type": "string",
                                        "enum": ["excellent", "normal", "poor"]
                                    },
                                    "price_per_unit": { "type": "number" },
                                    "supplier_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "reason": { "type": "string" },
                                    "temperature": { "type": "number" },
                                    "expiry_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "photo": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Unlisted item added successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/document-type": {
            "put": {
                "tags": ["Goods Receiving"],
                "summary": "Set Document Type",
                "description": "Set document type for receipt (invoice, delivery_note, receipt_without_document)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["document_type"],
                                "properties": {
                                    "document_type": {
                                        "type": "string",
                                        "enum": [
                                            "invoice",
                                            "delivery_note",
                                            "receipt_without_document"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Document type set successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/invoice": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Create Invoice",
                "description": "Create invoice for receipt with VAT calculation",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "invoice_number",
                                    "invoice_date",
                                    "amount_before_tax"
                                ],
                                "properties": {
                                    "invoice_number": {
                                        "type": "string",
                                        "maxLength": 100
                                    },
                                    "invoice_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "amount_before_tax": {
                                        "type": "number",
                                        "minimum": 0
                                    },
                                    "tax_rate": {
                                        "type": "number",
                                        "default": 15.0,
                                        "minimum": 0,
                                        "maximum": 100
                                    },
                                    "payment_terms": {
                                        "type": "string",
                                        "default": "Net 30 days",
                                        "maxLength": 100
                                    },
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Invoice created successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/{id}/delivery-note": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Create Delivery Note",
                "description": "Create delivery note for receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Delivery note created successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/receipt-without-document": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Create Receipt Without Document",
                "description": "Mark receipt as receipt without document",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Receipt without document created successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/complete": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Complete Inspection",
                "description": "Complete inspection and process variances automatically",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Inspection completed successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/save-draft": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Save as Draft",
                "description": "Save receipt as draft for later editing",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Receipt saved as draft successfully"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/{id}/draft": {
            "delete": {
                "tags": ["Goods Receiving"],
                "summary": "Delete Draft",
                "description": "Permanently delete a draft receipt",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Draft deleted successfully"
                    },
                    "400": {
                        "description": "Cannot delete non-draft receipt"
                    },
                    "404": {
                        "description": "Receipt not found"
                    }
                }
            }
        },
        "/variances/{varianceId}/action": {
            "post": {
                "tags": ["Goods Receiving"],
                "summary": "Handle Variance Action",
                "description": "Handle variance action (accept, create compensatory order, or deduct from invoice)",
                "parameters": [
                    {
                        "name": "varianceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["action"],
                                "properties": {
                                    "action": {
                                        "type": "string",
                                        "enum": [
                                            "accept",
                                            "compensatory_order",
                                            "deduct_from_invoice"
                                        ]
                                    },
                                    "supplier_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "source": { "type": "string" },
                                    "deadline": {
